// La web de OFI Draft Tool (ofidraft.com): páginas estáticas en `public/` y
// un Worker pequeño en `src/` para lo que necesita algo más.
// Se publica sola con cada cambio en la carpeta `web/` del repositorio de
// descargas (Workers Builds, en Cloudflare).
//
// **Lo que NO está aquí, porque este repositorio es público**, y se pone en
// Cloudflare como secreto. **En la sección de RUNTIME**, no en la de la
// compilación: Workers & Pages → ofi-draft-tool-web → Configuración →
// «Variables y secretos de runtime» → «+ Agregar variable» → marcar «Secreto»
// → «Añadir variable e implementar». (La otra sección, la que está junto a
// «Token de API» y las rutas de compilación, es solo para la compilación: el
// Worker no la ve. El 20-10 DESTINO estaba ahí y el formulario no mandaba nada.)
// Los secretos no se borran al publicar:
//   DESTINO          el correo al que llegan los avisos del formulario.
//   DESCARGA_CLAVE   la contraseña del equipo para bajar el instalador.
// Cómo saber si están, sin verlos:
//   POST /api/fallo con «{}»       → 503 si falta DESTINO, 403 si está.
//   POST /descargar/instalador con una clave mala → #clave-incorrecta si
//   DESCARGA_CLAVE está, #descarga-cerrada si falta.
{
  "name": "ofi-draft-tool-web",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  // Solo se entra por ofidraft.com: ni *.workers.dev ni direcciones de vista
  // previa.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Solo estas rutas pasan por el Worker; lo demás son ficheros, que no
    // cuentan para el límite diario del plan gratuito.
    "run_worker_first": ["/api/*", "/datos/*", "/descargar/instalador", "/descargar/instalador.exe"]
  },
  // El formulario de «Avisar de un fallo» manda un correo. A quién: el
  // secreto DESTINO.
  "send_email": [{ "name": "CORREO" }],
  "vars": {
    "REMITENTE": "web@ofidraft.com"
  },
  // La zona del equipo tenía un almacén (un Durable Object, «Zona»). Se quitó
  // el 2026-10-20 con la zona: la migración v2 lo borra de Cloudflare. Las
  // migraciones no se quitan nunca de esta lista: Cloudflare las aplica en
  // orden y recuerda cuál fue la última.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Zona"] },
    { "tag": "v2", "deleted_classes": ["Zona"] }
  ],
  // Opcional: un limitador de Cloudflare para el formulario, además del que
  // lleva el Worker con la caché. Si se quiere, se quita el `//` de la línea
  // de abajo (si el plan no lo admite, el despliegue falla y lo dice; entonces
  // se vuelve a poner).
  // "ratelimits": [{ "name": "LIMITE_FALLO", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  // Los mensajes de error del Worker (console.error), para poder arreglarlo;
  // NO el registro automático de cada petición, que guarda la IP y el
  // navegador de quien visita (la política de privacidad lo dice así).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
